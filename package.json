{
  "name": "systems-learning-core",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit && eslint . && vitest run",
    "test": "vitest run",
    "test:integration": "tsx tests/integration.ts",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @lab/web build",
    "dev:web": "pnpm --filter @lab/web dev",
    "dev:ordering": "tsx apps/ordering/src/main.ts",
    "dev:fulfillment": "tsx apps/fulfillment/src/main.ts",
    "dev:operator": "tsx apps/operator/src/main.ts",
    "openapi": "tsx tools/openapi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage && node tools/coverage-badge.mjs",
    "quality": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "monitor": "./scripts/monitor",
    "test:recovery": "tsx tests/recovery.ts",
    "test:learning": "tsx tests/learning-integration.ts",
    "check:public": "tsx tools/public-content.ts",
    "security": "./scripts/security-check",
    "security:images": "node tools/image-audit.mjs"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "@fastify/swagger": "9.9.1",
    "@lab/client": "workspace:*",
    "@lab/contracts": "workspace:*",
    "@lab/runtime": "workspace:*",
    "@prometheus-io/client": "0.16.1",
    "@redis/client": "6.3.0",
    "@sinclair/typebox": "0.34.41",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "amqplib": "0.10.9",
    "dotenv": "17.2.3",
    "fastify": "5.12.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.56.1",
    "@types/amqplib": "0.10.7",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module"
}

{
  "openapi": "3.0.3",
  "info": { "title": "fulfillment learning API", "version": "1.0.0" },
  "components": { "schemas": {} },
  "paths": {
    "/metrics": {
      "get": {
        "responses": {
          "2XX": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {},
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": { "format": "uuid", "type": "string" },
                        "correlationId": { "format": "uuid", "type": "string" },
                        "respondedAt": { "format": "date-time", "type": "string" }
                      },
                      "required": ["requestId", "correlationId", "respondedAt"]
                    }
                  },
                  "required": ["data", "meta"]
                }
              }
            }
          }
        }
      }
    },
    "/activity": {
      "get": {
        "responses": {
          "2XX": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "additionalProperties": true,
                        "type": "object",
                        "properties": {
                          "id": { "format": "uuid", "type": "string" },
                          "owner": { "type": "string" },
                          "type": { "type": "string" },
                          "occurredAt": { "format": "date-time", "type": "string" },
                          "streamId": { "format": "uuid", "type": "string" },
                          "sequence": { "minimum": 1, "type": "integer" },
                          "publicationId": { "format": "uuid", "type": "string" },
                          "deliveryId": { "format": "uuid", "type": "string" },
                          "correlationId": { "format": "uuid", "type": "string" },
                          "submissionReference": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
                          "requestId": { "format": "uuid", "type": "string" },
                          "eventId": { "format": "uuid", "type": "string" },
                          "eventType": { "type": "string" },
                          "orderId": { "format": "uuid", "type": "string" },
                          "jobId": { "format": "uuid", "type": "string" },
                          "attemptId": { "format": "uuid", "type": "string" },
                          "attemptNumber": { "minimum": 1, "type": "integer" },
                          "durationMs": { "minimum": 0, "type": "number" },
                          "method": { "type": "string" },
                          "route": { "type": "string" },
                          "status": { "anyOf": [{ "type": "integer" }, { "type": "string" }] },
                          "outcome": { "type": "string" },
                          "key": { "type": "string" }
                        },
                        "required": ["id", "owner", "type", "occurredAt"]
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": { "format": "uuid", "type": "string" },
                        "correlationId": { "format": "uuid", "type": "string" },
                        "respondedAt": { "format": "date-time", "type": "string" }
                      },
                      "required": ["requestId", "correlationId", "respondedAt"]
                    }
                  },
                  "required": ["data", "meta"]
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": { "get": { "responses": { "200": { "description": "Default Response" } } } },
    "/health": {
      "get": {
        "responses": {
          "2XX": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {},
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": { "format": "uuid", "type": "string" },
                        "correlationId": { "format": "uuid", "type": "string" },
                        "respondedAt": { "format": "date-time", "type": "string" }
                      },
                      "required": ["requestId", "correlationId", "respondedAt"]
                    }
                  },
                  "required": ["data", "meta"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system": {
      "get": {
        "responses": {
          "2XX": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {},
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": { "format": "uuid", "type": "string" },
                        "correlationId": { "format": "uuid", "type": "string" },
                        "respondedAt": { "format": "date-time", "type": "string" }
                      },
                      "required": ["requestId", "correlationId", "respondedAt"]
                    }
                  },
                  "required": ["data", "meta"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "parameters": [
          {
            "schema": { "format": "uuid", "type": "string" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "2XX": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {},
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": { "format": "uuid", "type": "string" },
                        "correlationId": { "format": "uuid", "type": "string" },
                        "respondedAt": { "format": "date-time", "type": "string" }
                      },
                      "required": ["requestId", "correlationId", "respondedAt"]
                    }
                  },
                  "required": ["data", "meta"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "put": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "preset": {
                    "anyOf": [
                      { "type": "string", "enum": ["success"] },
                      { "type": "string", "enum": ["slow"] },
                      { "type": "string", "enum": ["retry"] },
                      { "type": "string", "enum": ["fail"] }
                    ]
                  },
                  "paused": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {},
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": { "format": "uuid", "type": "string" },
                        "correlationId": { "format": "uuid", "type": "string" },
                        "respondedAt": { "format": "date-time", "type": "string" }
                      },
                      "required": ["requestId", "correlationId", "respondedAt"]
                    }
                  },
                  "required": ["data", "meta"]
                }
              }
            }
          }
        }
      }
    }
  }
}

      "updated": 1790980723457,
      "link": null,
      "locked": false,
      "text": "Expiry, eviction, corruption and outage all differ, but none permits a cache-only checkout.\nGET retry is bounded to one transient retry. Missing observations cannot establish current health.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expiry, eviction, corruption and outage all differ, but none permits a cache-only checkout.\nGET retry is bounded to one transient retry. Missing observations cannot establish current health.",
      "autoResize": true,
      "lineHeight": 1.15
    }

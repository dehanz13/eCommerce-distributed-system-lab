      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Source: apps/operator/src/main.ts; tools/operations.ts; resources.ts; activity-collection.ts; feeder.ts; experiments.ts; logs.ts\nStatic architecture; internal module cards are not additional processes. Full placement: drawing 07; live evidence: independent backend console.",
      "originalText": "Source: apps/operator/src/main.ts; tools/operations.ts; resources.ts; activity-collection.ts; feeder.ts; experiments.ts; logs.ts\nStatic architecture; internal module cards are not additional processes. Full placement: drawing 07; live evidence: independent backend console.",

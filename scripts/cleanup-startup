#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
project_root="$PWD"
listener_pids() {
  if [ "$(uname -s)" = Linux ]; then
    ss -H -ltnp "sport = :$1" | sed -n 's/.*pid=\([0-9]*\),.*/\1/p'
  else
    lsof -tiTCP:"$1" -sTCP:LISTEN 2>/dev/null || true
  fi
}
process_cwd() {
  if [ "$(uname -s)" = Linux ]; then
    readlink "/proc/$1/cwd"
  else
    lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p'
  fi
}
# Only stop listeners whose working directory belongs to this checkout.
for port in 4310 4311 4312 4313; do
  for pid in $(listener_pids "$port"); do
    if process_cwd "$pid" | rg -Fx -e "$project_root" -e "$project_root/apps/web" >/dev/null; then
      kill -KILL "$pid"
    fi
  done
done
rm -f .lab/web.pid .lab/ordering.pid .lab/fulfillment.pid .lab/operator.pid
